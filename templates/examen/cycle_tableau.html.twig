{% extends 'base.html.twig' %}

{% block title %}Examens -
	{{ cycle.name }}
{% endblock %}

{% block body %}
	<div class="container py-4 schedule-page">
		<div class="schedule-shell">
			<section class="schedule-hero">
				<span class="crud-hero__eyebrow">Examens</span>
				<h1 class="schedule-hero__title">Programme des devoirs -
					{{ cycle.name }}</h1>
				<p class="schedule-hero__subtitle">
					Retrouvez le planning des examens dans une présentation plus soignée, tout en conservant le tableau d'affichage actuel.
				</p>
			</section>

			<form method="get" action="{{ path('app_examen_cycle_index', {'id': cycle.id}) }}" class="crud-card schedule-config">
				<div class="schedule-config__row">
					<div>
						<h2 class="crud-section-title">Personnaliser l'entete</h2>
						<p class="crud-section-text">Ajoutez un libellé libre pour l'affichage ou l'impression du programme.</p>
					</div>
					<div class="schedule-config__field">
						<label class="form-label fw-semibold" for="entete">Entete personnalisee</label>
						<input id="entete" name="entete" class="form-control" value="{{ headerConfig.customHeader }}" placeholder="Texte libre (optionnel)">
					</div>
					<div class="schedule-config__submit">
						<button class="btn btn-dark" type="submit">Appliquer</button>
					</div>
				</div>
			</form>

			<div class="schedule-actions">
				<a href="{{ path('app_examen_new_for_cycle', {'id': cycle.id}) }}" class="btn btn-primary">Créer un examen</a>
				<a href="{{ path('app_examen_cycle_export_pdf', {'id': cycle.id, 'entete': headerConfig.customHeader}) }}" class="btn btn-outline-secondary">Exporter les examens en PDF</a>
				<a href="{{ path('exam_generate_surveillance_for_cycle', {'id': cycle.id}) }}" class="btn btn-outline-primary">Générer les surveillants</a>
				<a href="{{ path('surveillance_tableau_cycle', {'id': cycle.id, 'entete': headerConfig.customHeader}) }}" class="btn btn-info">Afficher les surveillants</a>
				<a href="{{ path('surveillance_tableau_export_cycle', {'format': 'pdf', 'id': cycle.id, 'entete': headerConfig.customHeader}) }}" class="btn btn-outline-info">Exporter la surveillance en PDF</a>
			</div>

			<div class="card schedule-table-card exam-program-card">
				<div class="card-body schedule-table-card__body">
					<div class="schedule-heading">
						<div>
							<h2 class="schedule-heading__title">{{ headerConfig.title }}</h2>
							<p class="schedule-heading__subtitle">{{ headerConfig.cycleLine }}</p>
						</div>
						<span class="crud-badge">{{ orderedLevels|length }}
							niveau(x)</span>
					</div>

					{% if programRows is empty %}
						<div class="alert alert-info mb-0">Aucun examen trouvé pour ce cycle.</div>
					{% else %}
						<div class="table-responsive">
							<table class="table exam-program-table align-middle mb-0">
								<thead>
									<tr>
										<th style="min-width: 190px;">Jours</th>
										<th style="min-width: 115px;">Heures</th>
										{% for level in orderedLevels %}
											<th>{{ level }}</th>
										{% endfor %}
									</tr>
								</thead>
								<tbody>
									{% set dayMap = {
										1: 'LUNDI',
										2: 'MARDI',
										3: 'MERCREDI',
										4: 'JEUDI',
										5: 'VENDREDI',
										6: 'SAMEDI',
										7: 'DIMANCHE'
									} %}
									{% for row in programRows %}
										<tr>
											<td class="exam-program-day">
												{{ dayMap[row.date|date('N')] ?? '' }}
												{{ row.date|date('d/m/Y') }}
											</td>
											<td class="exam-program-slot">{{ row.slot }}</td>
											{% for level in orderedLevels %}
												<td>
													{% if row.cells[level] is not empty %}
														{% for entry in row.cells[level] %}
															<div class="exam-entry">
																<div>{{ entry.label }}</div>
																{% if entry.id is not null %}
																	<div class="d-flex gap-2 mt-2 flex-wrap">
																		<a href="{{ path('app_examen_edit', {'id': entry.id, 'cycle_id': cycle.id}) }}" class="btn btn-sm btn-outline-warning">Modifier</a>
																		<form method="post" action="{{ path('app_examen_delete', {'id': entry.id, 'cycle_id': cycle.id}) }}" onsubmit="return confirm('Supprimer cet examen ?');">
																			<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ entry.id) }}">
																			<input type="hidden" name="cycle_id" value="{{ cycle.id }}">
																			<button class="btn btn-sm btn-outline-danger" type="submit">Supprimer</button>
																		</form>
																	</div>
																{% endif %}
															</div>
														{% endfor %}
													{% else %}
														<span class="text-muted">-</span>
													{% endif %}
												</td>
											{% endfor %}
										</tr>
									{% endfor %}
								</tbody>
							</table>
						</div>
					{% endif %}
				</div>
			</div>
		</div>
	</div>
{% endblock %}
