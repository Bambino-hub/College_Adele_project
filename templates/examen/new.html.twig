{% extends 'base.html.twig' %}

{% block title %}
	{% if cycle is defined and cycle %}
		Créer un examen -
		{{ cycle.name }}
	{% else %}
		Créer un examen
	{% endif %}
{% endblock %}

{% block body %}
	<div class="container py-4 examen-page">
		<div class="exam-shell">
			<div class="exam-shell__hero">
				<span class="exam-shell__eyebrow">Création d’examen</span>
				<h1 class="exam-shell__title">
					{% if cycle is defined and cycle %}
						Programmer un examen pour
						{{ cycle.name }}
					{% else %}
						Créer un nouvel examen
					{% endif %}
				</h1>
				<p class="exam-shell__subtitle">
					Renseignez la date, le créneau, la matière et les niveaux concernés pour préparer rapidement l’évaluation.
				</p>
			</div>

			{% set finishPath = cycle is defined and cycle ? path('app_examen_cycle_index', {'id': cycle.id}) : path('app_examen_index') %}
			{{ include('examen/_form.html.twig', {'finish_path': finishPath, 'button_label': "Enregistrer l’examen"}) }}
		</div>
	</div>
{% endblock %}
