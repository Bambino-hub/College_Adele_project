{% extends 'base.html.twig' %}

{% block title %}New Examen
{% endblock %}

{% block body %}
	{% for message in app.flashes('success') %}
		<div class="alert alert-success">{{ message }}</div>
	{% endfor %}

	<h1>
		{% if cycle is defined and cycle %}
			Créer un examen pour
			{{ cycle.name }}
		{% else %}
			Create new Examen
		{% endif %}
	</h1>

	{% set finishPath = cycle is defined and cycle ? path('app_examen_cycle_index', {'id': cycle.id}) : path('app_examen_index') %}
	{{ include('examen/_form.html.twig', {'finish_path': finishPath}) }}
{% endblock %}
