{% set targetField = form.levelTargets is defined ? form.levelTargets : form.classe %}

<div class="exam-form-card">
	{{ form_start(form, {'attr': {'class': 'exam-form'}}) }}

	<div class="exam-form__grid exam-form__grid--two">
		<div class="exam-form__field">
			{{ form_label(form.date, null, {'label_attr': {'class': 'exam-form__label'}}) }}
			{{ form_widget(form.date, {'attr': {'class': 'form-control exam-form__control'}}) }}
			{{ form_errors(form.date) }}
		</div>

		<div class="exam-form__field">
			{{ form_label(form.matiere, null, {'label_attr': {'class': 'exam-form__label'}}) }}
			{{ form_widget(form.matiere, {'attr': {'class': 'form-select exam-form__control'}}) }}
			{{ form_errors(form.matiere) }}
		</div>
	</div>

	<div class="exam-form__grid exam-form__grid--three">
		<div class="exam-form__field">
			{{ form_label(form.heursDebut, null, {'label_attr': {'class': 'exam-form__label'}}) }}
			{{ form_widget(form.heursDebut, {'attr': {'class': 'form-control exam-form__control'}}) }}
			{{ form_errors(form.heursDebut) }}
		</div>

		<div class="exam-form__field">
			{{ form_label(form.heureFin, null, {'label_attr': {'class': 'exam-form__label'}}) }}
			{{ form_widget(form.heureFin, {'attr': {'class': 'form-control exam-form__control'}}) }}
			{{ form_errors(form.heureFin) }}
		</div>

		<div class="exam-form__field">
			{{ form_label(form.nombreSurveillantsParClasse, null, {'label_attr': {'class': 'exam-form__label'}}) }}
			{{ form_widget(form.nombreSurveillantsParClasse, {'attr': {'class': 'form-control exam-form__control', 'min': 1}}) }}
			{{ form_errors(form.nombreSurveillantsParClasse) }}
		</div>
	</div>

	{% if form.levelTargets is defined %}
		<div class="exam-form__helper">
			{% if cycle is defined and cycle and cycle.name == 'Cycle 1' %}
				Cochez un
				<strong>niveau</strong>
				comme
				<strong>6eme</strong>
				ou
				<strong>5eme</strong>
				pour inclure automatiquement toutes les classes correspondantes.
			{% else %}
				Les choix sont regroupés par
				<strong>niveau / série</strong>
				pour distinguer clairement les classes du lycée.
			{% endif %}
		</div>
	{% endif %}

	<div class="exam-form__selection">
		<div class="exam-form__selection-header">
			<div>
				{{ form_label(targetField, null, {'label_attr': {'class': 'exam-form__section-title'}}) }}
				{% if targetField.vars.help %}
					<p class="exam-form__hint">{{ targetField.vars.help }}</p>
				{% endif %}
			</div>

			<label class="exam-form__toggle" for="toggle-all-classes">
				<input class="form-check-input" type="checkbox" id="toggle-all-classes">
				<span>{{ form.levelTargets is defined ? 'Tout sélectionner' : 'Toutes les classes' }}</span>
			</label>
		</div>

		{{ form_errors(targetField) }}
		<div class="exam-form__choice-panel">
			{{ form_widget(targetField) }}
		</div>
	</div>

	<div class="exam-form__actions">
		<button class="btn btn-primary px-4">{{ button_label|default("Enregistrer l’examen") }}</button>
		{% if finish_path is defined %}
			<a href="{{ finish_path }}" class="btn btn-outline-success px-4">Terminer</a>
		{% endif %}
	</div>

	{{ form_end(form) }}
</div>

<script>
	(function () {
const toggleId = 'toggle-all-classes';
const classContainerId = '{{ targetField.vars.id }}';

const getElements = function () {
const toggleAll = document.getElementById(toggleId);
const classContainer = document.getElementById(classContainerId);

if (! toggleAll || ! classContainer) {
return null;
}

return {toggleAll: toggleAll, classContainer: classContainer, classCheckboxes: classContainer.querySelectorAll('input[type="checkbox"]')};
};

const syncToggleAll = function () {
const elements = getElements();
if (! elements) {
return;
}

const total = elements.classCheckboxes.length;
const checked = Array.from(elements.classCheckboxes).filter(function (cb) {
return cb.checked;
}).length;

elements.toggleAll.checked = total > 0 && checked === total;
elements.toggleAll.indeterminate = checked > 0 && checked < total;
};

if (!window.__examToggleClassesBound) {
document.addEventListener('change', function (event) {
const elements = getElements();
if (! elements) {
return;
}

if (event.target && event.target.id === toggleId) {
elements.classCheckboxes.forEach(function (cb) {
cb.checked = elements.toggleAll.checked;
});
syncToggleAll();
return;
}

if (event.target && elements.classContainer.contains(event.target)) {
syncToggleAll();
}
});

window.__examToggleClassesBound = true;
}

document.addEventListener('DOMContentLoaded', syncToggleAll);
document.addEventListener('turbo:load', syncToggleAll);
window.addEventListener('pageshow', syncToggleAll);

syncToggleAll();
})();
</script>
