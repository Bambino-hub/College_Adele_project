{% extends 'base.html.twig' %}

{% block title %}Surveillants -
	{{ cycle.name }}
{% endblock %}

{% block body %}
	<div class="container py-4 schedule-page">
		<div class="schedule-shell">
			<section class="schedule-hero schedule-hero--surveillance">
				<span class="crud-hero__eyebrow">Surveillance</span>
				<h1 class="schedule-hero__title">Tableau de surveillance -
					{{ cycle.name }}</h1>
				<p class="schedule-hero__subtitle">
					La présentation a été allégée pour rester claire et professionnelle, sans modifier le tableau principal.
				</p>
			</section>

			<form method="get" action="{{ path('surveillance_tableau_cycle', {'id': cycle.id}) }}" class="crud-card schedule-config">
				<div class="schedule-config__row">
					<div>
						<h2 class="crud-section-title">Personnaliser l'entete</h2>
						<p class="crud-section-text">Vous pouvez définir un intitulé libre pour l'affichage ou l'export.</p>
					</div>
					<div class="schedule-config__field">
						<label class="form-label fw-semibold" for="entete">Entete personnalisee</label>
						<input id="entete" name="entete" class="form-control" value="{{ headerConfig.customHeader }}" placeholder="Texte libre (optionnel)">
					</div>
					<div class="schedule-config__submit">
						<button class="btn btn-dark" type="submit">Appliquer</button>
					</div>
				</div>
			</form>

			<div class="schedule-actions">
				<a href="{{ path('app_examen_cycle_index', {'id': cycle.id, 'entete': headerConfig.customHeader}) }}" class="btn btn-outline-secondary">Retour aux examens</a>
				<a href="{{ path('exam_generate_surveillance_for_cycle', {'id': cycle.id}) }}" class="btn btn-outline-primary">Régénérer les surveillances</a>
				<a href="{{ path('surveillance_tableau_export_cycle', {'format': 'pdf', 'id': cycle.id, 'entete': headerConfig.customHeader}) }}" class="btn btn-primary">Exporter le tableau en PDF</a>
			</div>

			<div class="card schedule-table-card surveillance-program-card">
				<div class="card-body schedule-table-card__body">
					<div class="schedule-heading">
						<div>
							<h2 class="schedule-heading__title">{{ headerConfig.title }}</h2>
							<p class="schedule-heading__subtitle">{{ headerConfig.cycleLine }}</p>
						</div>
						<span class="crud-badge">{{ orderedLevels|length }}
							niveau(x)</span>
					</div>

					{% if programRows is empty %}
						<div class="alert alert-info mb-0">Aucune surveillance générée.</div>
					{% else %}
						<div class="table-responsive">
							<table class="table surveillance-program-table align-middle mb-0">
								<thead>
									<tr>
										<th style="min-width: 190px;">Jours</th>
										<th style="min-width: 115px;">Heures</th>
										{% for niveau in orderedLevels %}
											<th>{{ niveau }}</th>
										{% endfor %}
									</tr>
								</thead>
								<tbody>
									{% set dayMap = {
										1: 'LUNDI',
										2: 'MARDI',
										3: 'MERCREDI',
										4: 'JEUDI',
										5: 'VENDREDI',
										6: 'SAMEDI',
										7: 'DIMANCHE'
									} %}

									{% for row in programRows %}
										<tr>
											<td class="surveillance-day">{{ dayMap[row.date|date('N')] ?? '' }}
												{{ row.date|date('d/m/Y') }}</td>
											<td class="surveillance-slot">{{ row.slot }}</td>
											{% for niveau in orderedLevels %}
												<td>
													{% if row.cells[niveau] is not empty %}
														{% for entry in row.cells[niveau] %}
															<div class="surveillance-entry">
																<div class="fw-semibold">{{ entry.matiere }}</div>
																{% if entry.assignments is not empty %}
																	{% for className, surveillants in entry.assignments %}
																		<div class="surveillance-assignment">
																			<span class="text-muted">{{ className }}:</span>
																			{{ surveillants|join(', ') }}
																		</div>
																	{% endfor %}
																{% else %}
																	<div class="text-muted">Aucun surveillant</div>
																{% endif %}
															</div>
														{% endfor %}
													{% else %}
														<span class="text-muted">-</span>
													{% endif %}
												</td>
											{% endfor %}
										</tr>
									{% endfor %}
								</tbody>
							</table>
						</div>
					{% endif %}
				</div>
			</div>
		</div>
	</div>
{% endblock %}
