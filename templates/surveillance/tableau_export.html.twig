<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<title>{{ headerConfig.title }}</title>
		<style>
			@page {
				size: A3 landscape;
				margin: 6mm;
			}

			body {
				margin: 0;
				font-family: "DejaVu Sans", Arial, sans-serif;
				color: #111;
				font-size: 11px;
			}

			.sheet {
				width: 100%;
				margin: 0 auto;
			}

			.page-break {
				page-break-after: always;
			}

			h2 {
				margin: 0 0 5px;
				text-align: center;
				font-size: 16px;
				text-transform: uppercase;
				letter-spacing: 0.02em;
			}

			.cycle-line {
				text-align: center;
				font-size: 12px;
				margin: 0 0 12px;
			}

			table {
				width: 100%;
				border-collapse: collapse;
				table-layout: auto;
			}

			th,
			td {
				border: 1px solid #222;
				padding: 6px 7px;
				vertical-align: top;
				font-size: 11px;
			}

			th {
				text-align: center;
				font-size: 10px;
				font-weight: 700;
				text-transform: uppercase;
				background: #efefef;
			}

			.day-col {
				width: 132px;
				font-weight: 700;
			}

			.slot-col {
				width: 88px;
				font-weight: 700;
				white-space: nowrap;
			}

			.entry {
				margin-bottom: 4px;
				border: 1px solid #d7d7d7;
				padding: 4px 5px;
			}

			.entry:last-child {
				margin-bottom: 0;
			}

			.assignment {
				line-height: 1.35;
				margin-top: 2px;
			}

			.class-name {
				font-weight: 700;
			}

			tr {
				page-break-inside: avoid;
			}

			.lycee th,
			.lycee td {
				font-size: 10px;
				padding: 4px;
			}

			.lycee .day-col {
				width: 118px;
			}

			.lycee .slot-col {
				width: 78px;
			}

			.lycee .entry {
				padding: 3px 4px;
				margin-bottom: 3px;
			}
		</style>
	</head>
	<body>
		{% set isLycee = cycle.name == 'Cycle 2' %}

		{% set dayMap = {
			1: 'LUNDI',
			2: 'MARDI',
			3: 'MERCREDI',
			4: 'JEUDI',
			5: 'VENDREDI',
			6: 'SAMEDI',
			7: 'DIMANCHE'
		} %}

		<div class="sheet {{ isLycee ? 'lycee' : '' }}">
			<h2>{{ headerConfig.title }}</h2>
			<div class="cycle-line">{{ headerConfig.cycleLine }}</div>

			<table>
				<thead>
					<tr>
						<th class="day-col">Jours</th>
						<th class="slot-col">Heures</th>
						{% for niveau in orderedLevels %}
							<th>{{ niveau }}</th>
						{% endfor %}
					</tr>
				</thead>
				<tbody>
					{% for row in programRows %}
						<tr>
							<td class="day-col">{{ dayMap[row.date|date('N')] ?? '' }}
								{{ row.date|date('d/m/Y') }}</td>
							<td class="slot-col">{{ row.slot }}</td>
							{% for niveau in orderedLevels %}
								<td>
									{% if row.cells[niveau] is not empty %}
										{% for entry in row.cells[niveau] %}
											<div class="entry">
												<strong>{{ entry.matiere }}</strong><br>
												{% if entry.assignments is not empty %}
													{% for className, surveillants in entry.assignments %}
														<div class="assignment">
															<span class="class-name">{{ className }}:</span>
															{{ surveillants|join(', ') }}
														</div>
													{% endfor %}
												{% else %}
													<span>Aucun surveillant</span>
												{% endif %}
											</div>
										{% endfor %}
									{% else %}
										-
									{% endif %}
								</td>
							{% endfor %}
						</tr>
					{% else %}
						<tr>
							<td colspan="{{ orderedLevels|length + 2 }}">Aucune surveillance générée.</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</body>
</html>
