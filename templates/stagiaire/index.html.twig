{% extends 'base.html.twig' %}

{% block title %}Stagiaires
{% endblock %}

{% block body %}
	<div class="container mt-4">
		<div class="d-flex justify-content-between align-items-center mb-3">
			<h1>Stagiaires</h1>
			<a href="{{ path('app_stagiaire_new') }}" class="btn btn-primary">Ajouter un stagiaire</a>
		</div>

		<table class="table table-striped table-bordered">
			<thead>
				<tr>
					<th>Nom</th>
					<th>Prénom</th>
					<th>Cycle</th>
					<th>Matière de stage</th>
					<th>Encadrant</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody>
				{% for stagiaire in stagiaires %}
					<tr>
						<td>{{ stagiaire.lastname }}</td>
						<td>{{ stagiaire.firstname }}</td>
						<td>{{ stagiaire.cycle ? stagiaire.cycle.name : 'Non défini' }}</td>
						<td>{{ stagiaire.matiereDeStage ? stagiaire.matiereDeStage.nom : 'Non définie' }}</td>
						<td>{{ stagiaire.encadrant ? stagiaire.encadrant.fullName : 'Non défini' }}</td>
						<td class="d-flex gap-2">
							<a href="{{ path('app_stagiaire_show', {'id': stagiaire.id}) }}" class="btn btn-info btn-sm">Voir</a>
							<a href="{{ path('app_stagiaire_edit', {'id': stagiaire.id}) }}" class="btn btn-warning btn-sm">Modifier</a>
						</td>
					</tr>
				{% else %}
					<tr>
						<td colspan="6">Aucun stagiaire enregistré.</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>
{% endblock %}
