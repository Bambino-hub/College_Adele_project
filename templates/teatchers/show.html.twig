{% extends 'base.html.twig' %}

{% block title %}Teatchers
{% endblock %}

{% block importmap %}

	{# on charge le js et le css global #}
	{{ parent() }}

	{# On charge le js et le css des enseignants #}
	{{ importmap('teachers') }}
{% endblock %}


{% block body %}
	<div class="teachers-page teachers-show">
		<h1 class="teachers-title">Détails de l'enseignant</h1>

		<div class="d-flex gap-3 mb-3 teachers-show-actions">
			<a href="{{ path('teatchers_index') }}" class="btn btn-secondary">Retour à la liste</a>
			<a href="{{ path('teatchers_edit', {'id': teatcher.id}) }}" class="btn btn-primary">edit</a>
			{{ include('teatchers/_delete_form.html.twig') }}
		</div>

		<table class="table table-success table-striped teachers-table">
			<tbody>
				<tr>
					<th>Id</th>
					<td>{{ teatcher.id }}</td>
				</tr>
				<tr>
					<th>NOM &amp; PRENOMS</th>
					<td>{{ teatcher.fullName }}</td>
				</tr>
				<tr>
					<th>SEXE</th>
					<td>{{ teatcher.sexe ?: '-' }}</td>
				</tr>
				<tr>
					<th>MATRICULE</th>
					<td>{{ teatcher.matricule ?: '-' }}</td>
				</tr>
				<tr>
					<th>STATUT</th>
					<td>{{ teatcher.statut ?: '-' }}</td>
				</tr>
				<tr>
					<th>DISCIPLINES</th>
					<td>{{ teatcher.disciplines ?: '-' }}</td>
				</tr>
				<tr>
					<th>Cycle (PDF)</th>
					<td>{{ teatcher.pdfCycle ?: '-' }}</td>
				</tr>
				<tr>
					<th>CONTACT</th>
					<td>{{ teatcher.phoneNumber }}</td>
				</tr>
			</tbody>
		</table>
	</div>
{% endblock %}
