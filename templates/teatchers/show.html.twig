{% extends 'base.html.twig' %}

{% block title %}Fiche enseignant
{% endblock %}

{% block importmap %}
	{{ parent() }}
	{{ importmap('teachers') }}
{% endblock %}

{% block body %}
	<div class="container py-4 crud-page">
		<div class="crud-shell crud-shell--narrow">
			<div class="crud-hero crud-hero--soft">
				<span class="crud-hero__eyebrow">Consultation</span>
				<h1 class="crud-hero__title">Fiche de l’enseignant</h1>
				<p class="crud-hero__subtitle">Visualisez rapidement les informations administratives et pédagogiques de l’enseignant sélectionné.</p>
			</div>

			<div class="crud-card teachers-show-card">
				<div class="teachers-profile-head">
					<div>
						<h2 class="teachers-profile-name">{{ teatcher.fullName }}</h2>
						<div class="teachers-profile-meta">
							<span class="crud-badge">{{ teatcher.sexe ?: 'Sexe non renseigné' }}</span>
							<span class="crud-badge">{{ teatcher.pdfCycle ?: 'Cycle non défini' }}</span>
							<span class="crud-badge">{{ teatcher.statut ?: 'Statut non renseigné' }}</span>
						</div>
					</div>
				</div>

				<div class="teachers-summary-grid">
					<div class="teachers-summary-item">
						<span class="teachers-summary-label">Identifiant</span>
						<strong>{{ teatcher.id }}</strong>
					</div>
					<div class="teachers-summary-item">
						<span class="teachers-summary-label">Contact</span>
						<strong>{{ teatcher.phoneNumber ?: '-' }}</strong>
					</div>
					<div class="teachers-summary-item teachers-summary-item--wide">
						<span class="teachers-summary-label">Disciplines</span>
						<strong>{{ teatcher.disciplines ?: 'Non renseignées' }}</strong>
					</div>
					<div class="teachers-summary-item">
						<span class="teachers-summary-label">Matricule</span>
						<strong>{{ teatcher.matricule ?: '-' }}</strong>
					</div>
				</div>
			</div>

			<div class="crud-actions">
				<div class="d-flex flex-wrap gap-2">
					<a href="{{ path('teatchers_index') }}" class="btn btn-outline-secondary">← Retour à la liste</a>
					<a href="{{ path('teatchers_edit', {'id': teatcher.id}) }}" class="btn btn-outline-primary">Modifier</a>
				</div>
				{{ include('teatchers/_delete_form.html.twig') }}
			</div>
		</div>
	</div>
{% endblock %}
