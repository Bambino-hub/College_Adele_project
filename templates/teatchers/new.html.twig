{% extends 'base.html.twig' %}

{% block importmap %}
	{{ parent() }}
	{{ importmap('teachers') }}
{% endblock %}

{% block title %}Ajouter un enseignant
{% endblock %}

{% block body %}
<div class="container py-4 crud-page">
	<div class="crud-shell crud-shell--narrow">
		<div class="crud-hero">
			<span class="crud-hero__eyebrow">Ressources humaines</span>
			<h1 class="crud-hero__title">Ajouter un enseignant</h1>
			<p class="crud-hero__subtitle">Enregistrez un enseignant avec ses informations administratives et pédagogiques dans une interface plus professionnelle.</p>
		</div>

		<div class="crud-actions mb-3">
			<a href="{{ path('teatchers_index') }}" class="btn btn-outline-secondary">← Retour à la liste</a>
		</div>

		<div class="teachers-form-wrapper">
			<turbo-frame id="teacher">
				{{ include('teatchers/_form.html.twig', { 'action': path('teatchers_create'), 'button_label': 'Enregistrer l\'enseignant' }) }}
				</turbo-frame>
			</div>
		</div>
	</div>
{% endblock %}
