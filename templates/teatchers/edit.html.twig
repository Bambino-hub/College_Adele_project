{% extends 'base.html.twig' %}

{% block importmap %}
	{{ parent() }}
	{{ importmap('teachers') }}
{% endblock %}

{% block title %}Modifier un enseignant
{% endblock %}

{% block body %}
	<div class="container py-4 crud-page">
		<div class="crud-shell crud-shell--narrow">
			<div class="crud-hero crud-hero--soft">
				<span class="crud-hero__eyebrow">Mise à jour</span>
				<h1 class="crud-hero__title">Modifier un enseignant</h1>
				<p class="crud-hero__subtitle">Ajustez les informations de l’enseignant puis sauvegardez les changements.</p>
			</div>

			<div class="crud-actions mb-3">
				<a href="{{ path('teatchers_index') }}" class="btn btn-outline-secondary">← Retour à la liste</a>
				{{ include('teatchers/_delete_form.html.twig') }}
			</div>

			<div class="teachers-form-wrapper">
				{{ include('teatchers/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
			</div>
		</div>
	</div>
{% endblock %}
