<form method="post" action="{{ path('teatchers_delete', {'id': teatcher.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');" class="teachers-delete-form">
	<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ teatcher.id) }}">
	<button class="btn btn-danger teachers-delete-btn">Delete</button>
</form>
