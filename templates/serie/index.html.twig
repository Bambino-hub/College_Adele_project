{% extends 'base.html.twig' %}

{% block title %}Séries
{% endblock %}

{% block body %}
	<div class="container py-4 crud-page">
		<div class="crud-shell">
			<div class="crud-hero">
				<span class="crud-hero__eyebrow">Organisation académique</span>
				<h1 class="crud-hero__title">Gestion des séries</h1>
				<p class="crud-hero__subtitle">Gérez les différentes séries du lycée de manière claire et professionnelle.</p>
			</div>

			<div class="crud-card">
				<div class="crud-toolbar mb-3">
					<div>
						<h2 class="crud-section-title">Séries disponibles</h2>
						<p class="crud-section-text">Centralisez les regroupements pédagogiques pour les classes du lycée.</p>
					</div>
					<a href="{{ path('app_serie_new') }}" class="btn btn-primary">Ajouter une série</a>
				</div>

				<div class="table-responsive">
					<table class="table crud-table align-middle">
						<thead>
							<tr>
								<th>Id</th>
								<th>Nom</th>
								<th>Actions</th>
							</tr>
						</thead>
						<tbody>
							{% for serie in series %}
								<tr>
									<td>{{ serie.id }}</td>
									<td>
										<span class="crud-badge">{{ serie.name }}</span>
									</td>
									<td>
										<div class="d-flex flex-wrap gap-2">
											<a href="{{ path('app_serie_show', {'id': serie.id}) }}" class="btn btn-sm btn-outline-secondary">Voir</a>
											<a href="{{ path('app_serie_edit', {'id': serie.id}) }}" class="btn btn-sm btn-outline-primary">Modifier</a>
										</div>
									</td>
								</tr>
							{% else %}
								<tr>
									<td colspan="3" class="crud-empty">Aucune série enregistrée.</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
