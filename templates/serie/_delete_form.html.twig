<form class="d-inline" method="post" action="{{ path('app_serie_delete', {'id': serie.id}) }}" onsubmit="return confirm('Supprimer cette série ?');">
	<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ serie.id) }}">
	<button class="btn btn-outline-danger">Supprimer</button>
</form>
