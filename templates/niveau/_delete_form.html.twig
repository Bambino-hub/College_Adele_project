<form class="d-inline" method="post" action="{{ path('app_niveau_delete', {'id': niveau.id}) }}" onsubmit="return confirm('Supprimer ce niveau ?');">
	<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ niveau.id) }}">
	<button class="btn btn-outline-danger">Supprimer</button>
</form>
