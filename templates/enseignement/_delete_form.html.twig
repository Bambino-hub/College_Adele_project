<form class="d-inline" method="post" action="{{ path('app_enseignement_delete', {'id': enseignement.id}) }}" onsubmit="return confirm('Supprimer cet enseignement ?');">
	<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ enseignement.id) }}">
	<button class="btn btn-outline-danger">Supprimer</button>
</form>
