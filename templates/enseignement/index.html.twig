{% extends 'base.html.twig' %}

{% block title %}Répartition des enseignements
{% endblock %}

{% block importmap %}
	{{ parent() }}
	{{ importmap('enseignement') }}
{% endblock %}

{% block body %}
	{% set totalTeachers = teacherTeachings|length %}
	{% set totalMatters = 0 %}
	{% set totalAssignments = 0 %}
	{% for teacherTeaching in teacherTeachings %}
		{% set totalMatters = totalMatters + teacherTeaching.matters|length %}
		{% for matterTeaching in teacherTeaching.matters %}
			{% set totalAssignments = totalAssignments + matterTeaching.assignments|length %}
		{% endfor %}
	{% endfor %}

	<div class="container py-4 teaching-page">
		<div class="teaching-shell">
			<div class="teaching-hero">
				<span class="teaching-hero__eyebrow">Pédagogie</span>
				<h1 class="teaching-hero__title">Répartition des enseignements</h1>
				<p class="teaching-hero__subtitle">
					Consultez les enseignants, leurs matières et les classes concernées dans une vue claire, moderne et professionnelle.
				</p>
			</div>

			<div class="teaching-stats">
				<div class="teaching-stat-card">
					<span class="teaching-stat-card__label">Enseignants</span>
					<strong>{{ totalTeachers }}</strong>
				</div>
				<div class="teaching-stat-card">
					<span class="teaching-stat-card__label">Matières affectées</span>
					<strong>{{ totalMatters }}</strong>
				</div>
				<div class="teaching-stat-card">
					<span class="teaching-stat-card__label">Classes liées</span>
					<strong>{{ totalAssignments }}</strong>
				</div>
			</div>

			<div class="teaching-toolbar">
				<div>
					<h2 class="crud-section-title">Vue détaillée des affectations</h2>
					<p class="crud-section-text">Chaque carte regroupe les matières assurées par un enseignant et les classes correspondantes.</p>
				</div>
				<a class="btn btn-primary" href="{{ path('app_enseignement_new') }}">Ajouter un enseignement</a>
			</div>

			{% if teacherTeachings is empty %}
				<div class="crud-card">
					<div class="crud-empty">Aucun enseignement trouvé pour le moment.</div>
				</div>
			{% else %}
				<div class="teaching-groups">
					{% for teacherTeaching in teacherTeachings %}
						<article class="teaching-teacher-card">
							<div class="teaching-teacher-head">
								<div>
									<h3 class="teaching-teacher-name">{{ teacherTeaching.teacher_full_name }}</h3>
									<p class="teaching-teacher-subtitle">{{ teacherTeaching.matters|length }}
										matière(s) attribuée(s)</p>
								</div>
								<span class="crud-badge">{{ teacherTeaching.matters|length }}
									matières</span>
							</div>

							<div class="teaching-subject-list">
								{% for matterTeaching in teacherTeaching.matters %}
									<div class="teaching-subject-row">
										<div class="teaching-subject-main">
											<div class="teaching-subject-name">{{ matterTeaching.matter_name }}</div>
											<div class="teaching-class-list">
												{% for assignment in matterTeaching.assignments %}
													<span class="teaching-class-chip">{{ assignment.class_name }}</span>
												{% endfor %}
											</div>
										</div>

										<div class="teaching-actions">
											{% for assignment in matterTeaching.assignments %}
												<div class="teaching-action-item">
													<a class="btn btn-sm btn-outline-primary" href="{{ path('app_enseignement_edit', {'id': assignment.id}) }}">Modifier
														{{ assignment.class_name }}</a>
													<form method="post" action="{{ path('app_enseignement_delete', {'id': assignment.id}) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer cet enseignement ?');">
														<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ assignment.id) }}">
														<button class="btn btn-sm btn-outline-danger">Supprimer</button>
													</form>
												</div>
											{% endfor %}
										</div>
									</div>
								{% endfor %}
							</div>
						</article>
					{% endfor %}
				</div>
			{% endif %}
		</div>
	</div>
{% endblock %}
