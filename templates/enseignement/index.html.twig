{% extends 'base.html.twig' %}

{% block title %}Enseignement index
{% endblock %}

{% block body %}
	<h1>Enseignement index</h1>

	<table class="table">
		<thead>
			<tr>
				<th>Id</th>
				<th>actions</th>
			</tr>
		</thead>
		<tbody>
			{% for enseignement in enseignements %}
				<tr>
					<td>{{ enseignement.id }}</td>
					<td>{{ enseignement.teacher.lastname }}
						-
						{{ enseignement.matter.nom }}
						-
						{{ enseignement.className.name }}</td>
					<td>
						<a href="{{ path('app_enseignement_show', {'id': enseignement.id}) }}">show</a>
						<a href="{{ path('app_enseignement_edit', {'id': enseignement.id}) }}">edit</a>
					</td>
				</tr>
			{% else %}
				<tr>
					<td colspan="2">no records found</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>

	<a href="{{ path('app_enseignement_new') }}">Create new</a>
{% endblock %}
