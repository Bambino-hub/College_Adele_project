{% extends 'base.html.twig' %}

{% block title %}Modifier un cycle
{% endblock %}

{% block body %}
	<div class="container py-4 crud-page">
		<div class="crud-shell crud-shell--narrow">
			<div class="crud-hero crud-hero--soft">
				<span class="crud-hero__eyebrow">Mise à jour</span>
				<h1 class="crud-hero__title">Modifier un cycle</h1>
				<p class="crud-hero__subtitle">Ajustez le libellé ou l’organisation du cycle sélectionné.</p>
			</div>

			{{ include('cycles/_form.html.twig', {'button_label': 'Mettre à jour', 'finish_path': path('app_cycles_index')}) }}

			<div class="crud-actions">
				<a href="{{ path('app_cycles_index') }}" class="btn btn-outline-secondary">← Retour à la liste</a>
				{{ include('cycles/_delete_form.html.twig') }}
			</div>
		</div>
	</div>
{% endblock %}
