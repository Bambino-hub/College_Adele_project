{% extends 'base.html.twig' %}

{% block title %}Détail de la classe
{% endblock %}

{% block body %}
	<div class="container py-4 crud-page">
		<div class="crud-shell crud-shell--narrow">
			<div class="crud-hero crud-hero--soft">
				<span class="crud-hero__eyebrow">Consultation</span>
				<h1 class="crud-hero__title">Détail de la classe</h1>
				<p class="crud-hero__subtitle">Retrouvez la structure complète de la classe sélectionnée.</p>
			</div>

			<div class="crud-card">
				<table class="table crud-detail-table">
					<tbody>
						<tr>
							<th>Identifiant</th>
							<td>{{ class_name.id }}</td>
						</tr>
						<tr>
							<th>Nom</th>
							<td>{{ class_name.name }}</td>
						</tr>
						<tr>
							<th>Cycle</th>
							<td>{{ class_name.niveau and class_name.niveau.cycle ? class_name.niveau.cycle.name : '-' }}</td>
						</tr>
						<tr>
							<th>Niveau</th>
							<td>{{ class_name.niveau ? class_name.niveau.name : '-' }}</td>
						</tr>
						<tr>
							<th>Série</th>
							<td>{{ class_name.serie ? class_name.serie.name : '-' }}</td>
						</tr>
					</tbody>
				</table>
			</div>

			<div class="crud-actions">
				<div class="d-flex flex-wrap gap-2">
					<a href="{{ path('app_class_name_index') }}" class="btn btn-outline-secondary">← Retour à la liste</a>
					<a href="{{ path('app_class_name_edit', {'id': class_name.id}) }}" class="btn btn-outline-primary">Modifier</a>
				</div>
				{{ include('class_name/_delete_form.html.twig') }}
			</div>
		</div>
	</div>
{% endblock %}
