<div class="crud-form-card">
	{{ form_start(form, {'attr': {'class': 'crud-form'}}) }}
	{{ form_row(form.name) }}
	{{ form_row(form.cycle) }}
	{{ form_row(form.niveau) }}
	{{ form_row(form.serie) }}

	<div class="crud-actions">
		{{ form_widget(form.save, {'attr': {'class': 'btn btn-primary'}, 'label': button_label|default('Enregistrer')}) }}
		{% if finish_path is defined %}
			<a href="{{ finish_path }}" class="btn btn-outline-secondary">Terminer</a>
		{% endif %}
	</div>
	{{ form_end(form) }}
</div>
