<form class="d-inline" method="post" action="{{ path('app_class_name_delete', {'id': class_name.id}) }}" onsubmit="return confirm('Supprimer cette classe ?');">
	<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ class_name.id) }}">
	<button class="btn btn-outline-danger">Supprimer</button>
</form>
