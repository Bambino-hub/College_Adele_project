<form class="d-inline" method="post" action="{{ path('app_matter_delete', {'id': matter.id}) }}" onsubmit="return confirm('Supprimer cette matière ?');">
	<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ matter.id) }}">
	<button class="btn btn-outline-danger">Supprimer</button>
</form>
